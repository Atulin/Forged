<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
        <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --config-file $(MSBuildThisFileDirectory)testconfig.json</TestingPlatformCommandLineArguments>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
        <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />
        <PackageReference Include="TUnit" Version="1.69.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Forged.Core\Forged.Core.csproj" />
        <ProjectReference Include="..\Forged.Generator\Forged.Generator.csproj" />
        <ProjectReference Include="..\Forged.Generator\Forged.Generator.csproj" OutputItemType="Analyzer" />
    </ItemGroup>

</Project>